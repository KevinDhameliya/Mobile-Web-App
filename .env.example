# Copy to .env.local for local development, or set in Netlify:
# Site configuration → Environment variables.
#
# WARNING: every VITE_* variable is embedded in the public JavaScript bundle and
# can be read by anyone. Never put API keys, tokens or other secrets here.

# Base URL of your backend API (no trailing slash). Leave empty for none.
VITE_API_BASE_URL=

# Lightweight health-check path on that API. Defaults to /health.
VITE_API_HEALTH_PATH=/health
